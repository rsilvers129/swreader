<Project Sdk="Microsoft.NET.Sdk">
  <!-- Late-bound COM: no SolidWorks assemblies are referenced, so this builds anywhere (also on Linux/CI)
       and runs against any installed SolidWorks version. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>swexport</AssemblyName>
    <RootNamespace>SwExport</RootNamespace>
    <Version>1.0.1</Version>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
